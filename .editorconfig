root = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,ipp,inl,m,mm,rc}]
charset = utf-8-bom
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.{md,xml,txt}]
charset = utf-8-bom
end_of_line = lf
insert_final_newline = true

[*.{cmake,ps1,bat,cmd,json,yml,yaml}]
charset = utf-8-bom
end_of_line = lf
insert_final_newline = true

# Shebang must be first byte on Unix: UTF-8 without BOM for *.py / *.sh.
[*.py]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.sh]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[CMakeLists.txt]
charset = utf-8-bom
end_of_line = lf
insert_final_newline = true
